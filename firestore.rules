rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two accounts count as admins, identified by User UID (Authentication > Users).
    // fatwa@duny.us = Auuj7...T33, a.khan120701@gmail.com = MHjOs...Vv2. To add or remove an admin,
    // edit this list, publish the rules, and add/delete the user under Authentication > Users.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['Auuj7lWnl4ciBdCEMMIcTCORLT33', 'MHjOs8I1aTPwHa2IhO4XUISvJvV2'];
    }

    // Everything below is publicly readable; only an admin may create/update/delete.
    match /fatwas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /magazine/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site-wide settings, e.g. settings/hiddenFatwas = { slugs: [...] }.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
